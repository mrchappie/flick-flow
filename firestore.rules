rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Functions to check ownership and admin status
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isListOwner() {
      // Access the userID from the list document data
      return request.auth != null && request.resource.data.userID == request.auth.uid;
    }

    function isListOwnerCreate() {
      // Access the userId from the data being written during a create operation
      return request.auth != null && resource.data.userID == request.auth.uid;
    }

    function isAdmin() {
      // Check if the custom claim 'role' is set to 'admin'
      return request.auth != null && request.auth.token.role == 'admin';
    }
    
    // Users Collection Rules
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write, delete: if isOwner(userId) || isAdmin();
    }

    // Lists Collection Rules
    match /lists/{listId=**} {
      // Handle read operations for existing documents
      allow read: if isListOwner() || isAdmin();

      // Handle update and delete operations for existing documents
      allow update, delete: if resource != null && (isListOwner() || isAdmin());

      // Handle create operations where resource is null
      allow create: if request.resource != null && (isListOwnerCreate() || isAdmin());
    }
  }
}
