rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Block access by default
    match /{document=**} {
      allow read, write, delete: if false;
    }

    // Users Collection Rules
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write, delete: if (isOwner(userId) || isAdmin());
    }

    // Lists Collection Rules
    match /lists/{listId} {
      // Handle read operations for existing documents
      allow read: if isListOwner(listId) || isAdmin();

      // Handle update and delete operations for existing documents
      allow update, delete: if isListOwner(listId) || isAdmin();

      // Handle create operations where resource is null
      allow create: if isListOwnerCreate() || isAdmin();
    }

    // Lists SubCollection Rules
    match /lists/{listId}/{subCollType}/{subCollId} {
      // Handle read operations for existing documents
      allow read: if isListOwner(listId) || isAdmin();

      // Handle update and delete operations for existing documents
      allow update, delete: if isListOwner(listId) || isAdmin();

      // Handle create operations where resource is null
      allow create: if isListOwnerCreate() || isAdmin();
    }

    // Users Collection Rules
    match /settings/{docID=**} {
      allow read: if isAdmin();
      allow write, delete: if  isAdmin();
    }
    
    
    // Functions to check ownership and admin status
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isListOwner(listId) {
      return request.auth != null && (get(/databases/$(database)/documents/lists/$(listId)).data.userID == request.auth.uid || request.auth.token.role == 'admin');
    }

    function isListOwnerCreate() {
      return request.auth != null && (request.resource.data.userID == request.auth.uid || request.auth.token.role == 'admin');
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }
  }
}


rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if isAdmin();
      allow write, delete: if  isAdmin();
    }
    
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }
  }
}